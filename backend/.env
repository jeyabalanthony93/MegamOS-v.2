# Environment Configuration
# Development/Testing Setup

# Server Configuration
DEBUG=True
ENVIRONMENT=development
APP_NAME=MegamOS
APP_VERSION=2.0.0

# API Configuration
ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]

# Database (SQLite for development - no setup needed)
DATABASE_URL=sqlite:///./megamos_dev.db

# MongoDB (optional, can skip for now)
MONGODB_URL=mongodb://localhost:27017/megamos

# Redis (optional, can skip for now)
REDIS_URL=redis://localhost:6379/0

# AI Services
GEMINI_API_KEY=test-key-for-development

# Authentication
SECRET_KEY=dev-secret-key-change-in-production-megamos-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
CORS_ENABLED=True
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# Monetization
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
SENDGRID_API_KEY=SG.test

# Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=104857600

# Logging
LOG_LEVEL=INFO
